[Unit]
Description=mini-fw daemon (eBPF/TC inbound firewall)
Documentation=https://github.com/seawallnetworks/mini-fw
# Front ends such as sw_configd send the policy once mfwd is up.
Before=sw_configd.service

[Service]
# The socket, /run/mfwd.sock, is mode 0660, group mfw (sysusers.d/mini-fw.conf):
# root and the group's members, such as sw_configd, may connect. Whoever can
# replaces the policy. For root alone, drop -g and -m with "systemctl edit mfwd".
ExecStart=/usr/local/seawall/sbin/mfwd -g mfw -m 0660
Restart=on-failure
# root, but only with the capabilities BPF and TC need, and CAP_CHOWN to
# give the socket to its group
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN CAP_PERFMON CAP_CHOWN
ProtectSystem=strict
ReadWritePaths=/sys/fs/bpf /run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
# Stopping mfwd does not stop filtering: the TC program stays attached
# through the pinned links. Use "mfwd -P" to remove mini-fw from every interface.

[Install]
WantedBy=multi-user.target
